# Optional: compatible API base ending in /v1; never commit actual keys.
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
# Required to enable review and document publishing. Use your own strong value.
ADMIN_TOKEN=
# Default bind is loopback. Keep it for personal local use.
BIND_ADDRESS=127.0.0.1
PORT=8087
# scripts/dev.py generates service tokens in memory and enables DSH automatically.
DSH_PORT=8117
# When running the Java service alone, DSH stays disabled by default.
DSH_ENABLED=false
